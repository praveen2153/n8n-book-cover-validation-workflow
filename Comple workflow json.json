      "parameters": {
        "jsCode": "const text = $json[0].content[0].text;\n\n// Remove markdown code fences\nconst cleanText = text\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .trim();\n\nlet result;\n\ntry {\n  result = JSON.parse(cleanText);\n} catch (error) {\n  result = {\n    status: \"REVIEW NEEDED\",\n    confidence: 50,\n    ISBN:1236746,\n    severity: \"HIGH\",\n    issues: [\"Failed to parse AI response\"],\n    instructions: \"Manual review required\",\n    summary: \"OpenAI response parsing failed.\"\n  };\n}\n\nreturn [{\n  json: result\n}];"
      },
